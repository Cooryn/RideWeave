{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RideWeave",
  "version": "0.1.0",
  "identifier": "com.rideweave.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "骑络 RideWeave",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https://*.tile.openstreetmap.org; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "个人骑行轨迹管理",
    "category": "Sports",
    "icon": ["icons/icon.ico"]
  }
}
